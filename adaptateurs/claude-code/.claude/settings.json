    "ask": [
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release:*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git tag:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git reset:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh release:*)"
    ],
    "allow": [
      "PowerShell(./scripts/verifier-tache.ps1 2>$null)",
      "PowerShell(./scripts/suivi.ps1*)",
      "PowerShell(./scripts/suivi.test.ps1*)"
    ]
  }
}
