{
  "permissions": {
    "deny": [
      "Bash(git add -A:*)",
      "Bash(git add .:*)",
      "Bash(git add --all:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit -n:*)",
      "Bash(git * --no-verify*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git -c *)",
      "Bash(git config *hooksPath*)",
      "PowerShell(git add -A:*)",
      "PowerShell(git add .:*)",
      "PowerShell(git add --all:*)",
      "PowerShell(git commit --no-verify:*)",
      "PowerShell(git commit -n:*)",
      "PowerShell(git * --no-verify*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git -c *)",
      "PowerShell(git config *hooksPath*)"
